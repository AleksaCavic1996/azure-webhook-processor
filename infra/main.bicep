// Entry point for all Azure infrastructure of the webhook processor.
// Deployed at subscription scope so that the resource group itself is part of the template.
// Use infra/deploy.ps1, which supplies the signing secret without ever printing it.
targetScope = 'subscription'

@description('Azure region for the resource group and everything in it.')
param location string = 'northeurope'

@description('Name of the resource group that holds the whole project. Deleting it removes every resource.')
param resourceGroupName string = 'rg-webhook-processor'

@description('Name of the queue the API writes to and the worker reads from. Must match ServiceBus:QueueName.')
param queueName string = 'payment-events'

@description('Database name, same as in the local docker-compose setup.')
param postgresDatabaseName string = 'webhooks'

@secure()
@description('Secret the webhook provider signs requests with. Generated by deploy.ps1 on first run, then reused.')
param webhookSigningSecret string

@description('Image tag for the API and the worker, for example sha-<commit>. CI publishes one per commit on main.')
param imageTag string

// GitHub issues tokens with an immutable subject: names plus numeric owner and repository ids.
// The ids keep the trust bound to this exact repository even if a name is later reused.
// Read it with: gh api repos/<owner>/<repo>/actions/oidc/customization/sub
@description('Subject prefix of the GitHub OIDC token for the repository whose main branch may deploy.')
param githubSubjectPrefix string = 'repo:AleksaCavic1996@95768451/azure-webhook-processor@1447541587'

@description('Object id of the deploying user. Gets access to the Key Vault secret and to the queue (to replay dead letters). Empty = no assignment.')
param deployerPrincipalId string = ''

@description('Address that receives alert emails. Passed by deploy.ps1 so that it is not stored in the repository.')
param alertEmail string = ''

var tags = {
  project: 'azure-webhook-processor'
  managedBy: 'bicep'
}

resource resourceGroup 'Microsoft.Resources/resourceGroups@2024-03-01' = {
  name: resourceGroupName
  location: location
  tags: tags
}

module identities 'modules/identities.bicep' = {
  name: 'identities'
  scope: resourceGroup
  params: {
    location: location
    tags: tags
    githubSubjectPrefix: githubSubjectPrefix
  }
}

module network 'modules/network.bicep' = {
  name: 'network'
  scope: resourceGroup
  params: {
    location: location
    tags: tags
  }
}

module serviceBus 'modules/servicebus.bicep' = {
  name: 'servicebus'
  scope: resourceGroup
  params: {
    location: location
    tags: tags
    queueName: queueName
    apiPrincipalId: identities.outputs.apiPrincipalId
    workerPrincipalId: identities.outputs.workerPrincipalId
    scalerPrincipalId: identities.outputs.scalerPrincipalId
    operatorPrincipalId: deployerPrincipalId
  }
}

module postgres 'modules/postgres.bicep' = {
  name: 'postgres'
  scope: resourceGroup
  params: {
    location: location
    tags: tags
    databaseName: postgresDatabaseName
    subnetId: network.outputs.postgresSubnetId
    privateDnsZoneId: network.outputs.postgresDnsZoneId
    workerPrincipalId: identities.outputs.workerPrincipalId
    workerIdentityName: identities.outputs.workerIdentityName
  }
}

module keyVault 'modules/keyvault.bicep' = {
  name: 'keyvault'
  scope: resourceGroup
  params: {
    location: location
    tags: tags
    deployerPrincipalId: deployerPrincipalId
    apiPrincipalId: identities.outputs.apiPrincipalId
    webhookSigningSecret: webhookSigningSecret
  }
}

module apps 'modules/apps.bicep' = {
  name: 'apps'
  scope: resourceGroup
  params: {
    location: location
    tags: tags
    imageTag: imageTag
    subnetId: network.outputs.appsSubnetId
    apiIdentityId: identities.outputs.apiIdentityId
    apiClientId: identities.outputs.apiClientId
    workerIdentityId: identities.outputs.workerIdentityId
    workerIdentityName: identities.outputs.workerIdentityName
    workerClientId: identities.outputs.workerClientId
    scalerIdentityId: identities.outputs.scalerIdentityId
    deployPrincipalId: identities.outputs.deployPrincipalId
    queueName: queueName
    serviceBusFullyQualifiedNamespace: serviceBus.outputs.fullyQualifiedNamespace
    postgresHost: postgres.outputs.host
    postgresDatabaseName: postgresDatabaseName
    signingSecretUri: keyVault.outputs.signingSecretUri
  }
}

module monitoring 'modules/monitoring.bicep' = {
  name: 'monitoring'
  scope: resourceGroup
  params: {
    tags: tags
    alertEmail: alertEmail
    serviceBusNamespaceId: serviceBus.outputs.namespaceId
    queueName: queueName
    apiId: apps.outputs.apiId
  }
}

output resourceGroupName string = resourceGroup.name
output serviceBusFullyQualifiedNamespace string = serviceBus.outputs.fullyQualifiedNamespace
output queueName string = queueName
output postgresServerName string = postgres.outputs.serverName
output keyVaultName string = keyVault.outputs.vaultName
output apiUrl string = apps.outputs.apiUrl
output logWorkspaceName string = apps.outputs.logWorkspaceName
output applicationInsightsName string = apps.outputs.applicationInsightsName
output imageTag string = imageTag
output deployClientId string = identities.outputs.deployClientId
output tenantId string = tenant().tenantId
output subscriptionId string = subscription().subscriptionId
