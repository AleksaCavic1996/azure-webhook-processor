# Copy to .env and fill in. Never commit .env.

# Local PostgreSQL password.
POSTGRES_PASSWORD=

# SQL Server SA password, used only by the Service Bus emulator.
# Needs 8+ characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=

# Set to Y to accept the Service Bus emulator and SQL Server Linux license terms:
# https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
# https://go.microsoft.com/fwlink/?LinkId=746388
ACCEPT_EULA=N
